# Copy to .env.local and adjust, then restart `npm run dev`.

# Demo mode. While true, Mock Service Worker returns illustrative API
# responses and no backend is required. Set to false to call a real backend.
VITE_USE_MOCK_API=true

# Base URL of your backend, without a trailing slash. Required when
# VITE_USE_MOCK_API is false, unless the backend is served from the same
# origin as the frontend, in which case leave this empty.
VITE_API_BASE_URL=http://localhost:8080
